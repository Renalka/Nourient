# Nourient Environment Variables

# Environment
ENVIRONMENT=development

# Google AI Studio API Key (Required for Gemini Vision and TrueLabel reasoning)
# Get this from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Service Account Key (Required for local database development)
# Get this from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Example: ./firebase-adminsdk.json
FIREBASE_CREDENTIALS_PATH=
