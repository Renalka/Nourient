worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    error_log /dev/stderr info;

    client_max_body_size 20m;
    proxy_connect_timeout 30s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    server {
        listen ${PORT};
        server_name _;

        location = /health {
            proxy_pass http://127.0.0.1:8003;
        }

        location /api/v1/orchestrate/ {
            proxy_pass http://127.0.0.1:8003;
        }

        location /api/v1/basket/ {
            proxy_pass http://127.0.0.1:8007;
        }

        # Profile updates are the only BioContext route exposed publicly. The
        # score-evaluation route remains available only to the orchestrator.
        location = /api/v1/biocontext/update_profile {
            proxy_pass http://127.0.0.1:8005;
        }

        location /api/v1/alternatives/ {
            proxy_pass http://127.0.0.1:8006;
        }

        location = /dictionary {
            proxy_pass http://127.0.0.1:8004;
        }

        location / {
            return 404;
        }
    }
}
